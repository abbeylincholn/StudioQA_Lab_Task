{
  "compilerOptions": {
    "target": "ES2022",
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": "src",
    "paths": {
      "pages/*": ["pages/*"],
      "utils/*": ["utils/*"]
    },
    "types": ["node", "playwright"]
  },
  "include": ["src/**/*.ts"]
}
